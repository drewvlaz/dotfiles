#! /bin/bash

see() {
  which $1 | bat -l sh
}

gt() {
  if [ "$1" = "restack" ] || [ "$1" = "r" ]; then
    echo "gt: '$1' is disabled (rewrites parents -> force push). Run 'ch $1' explicitly if you really want it." >&2
    return 1
  fi
  ch "$@"
}

diffs() {
  diff <(tr -s ' ' <$1) <(tr -s ' ' <$2) -u -d | delta
}

ed() {
  file=$(
    du -a \
      -I .git \
      -I .github \
      -I .ruff_cache \
      -I .cursor \
      . |
      awk '{print $2}' |
      fzf \
        --preview 'bat --style=plain --color=always {}' \
        --preview-window noborder
  )
  if [ -n "$file" ]; then
    $EDITOR $file
  fi
}

gdel() {
  target_branch=$(git branch --list | fzf | sed 's/^[[:space:]]*//')
  if [ -z "$target_branch" ]; then
    return
  fi

  git branch -d "$target_branch"
  ret_val=$?

  if [ $ret_val -ne 0 ]; then
    echo "Are you sure you want to delete the branch?"
    response=$(echo "n\ny" | fzf)
    if [ "$response" = "y" ]; then
      git branch -D "$target_branch"
    fi
  fi
}

gtl() {
  target=$(git worktree list | fzf --prompt='❯ ' --pointer='❯ ' | awk '{print $1}')
  if [ -n "$target" ]; then
    cd $target
  fi
}

gta() {
  git worktree add "../$1" && cd "../$1" && mise trust
}

gtd() {
  echo "Deleting worktree..."
  if [ -z "$1" ]; then
    git worktree list |
      rg -v '(dev/interop|dev/partner|dev/backend|dev/patient)' |
      fzf --prompt='❯ ' --pointer='❯ ' |
      awk '{print $1}' |
      sed 's/^[[:space:]]*//' | sed 's|.*/||' |
      xargs git worktree remove
  else
    git worktree remove $1
  fi
}

squash() {
  current_branch=$(git branch --show-current)

  # The original base of the current branch
  if [ -z "$1" ]; then
    og_base_unparsed=$(git branch --list | fzf --prompt='Base: ')
    if [ $? -ne 0 ]; then
      return
    fi
    og_base=$(echo $og_base_unparsed | sed 's/^[[:space:]]*//')
  else
    og_base=$1
  fi

  # # The target base of the current branch
  # if [ -z "$2" ]; then
  #   target_base_unparsed=$(git branch --list | fzf --prompt='To: ')
  #   if [ $? -ne 0 ]; then
  #     return
  #   fi
  #   target_base=$(echo $target_base_unparsed | sed 's/^[[:space:]]*//')
  # else
  #   target_base=$1
  # fi

  # Diff the head of the current branch against the target branch
  git diff $og_base..HEAD >changes.patch

  # Create a backup branch just in case
  git checkout -b "TMP/$current_branch"

  # Clean branch under same name as current branch
  # git checkout $target_base
  git checkout $og_base
  git branch -D $current_branch
  git checkout -b $current_branch

  # Apply the changes
  git apply changes.patch
}

dfile() {
  file=$(du -a src | awk '{print $2}' | fzf --prompt='❯ ' --pointer='❯ ')
  if [ -n "$file" ]; then
    git log --follow -p -- "$file"
  fi
}

dfunc() {
  if [ -z "$1" ]; then
    return
  fi
  func=$1
  file=$(rg --files-with-matches "^\s*def $func\(" | fzf --prompt='❯ ' --pointer='❯ ')
  if [ -n "$file" ]; then
    git log -L :$func:$file
  fi
}

maxmigr() {
  max=$(ls src/migrations | grep -E '^[0-9]+_' | tail -n 1 | cut -d '.' -f 1)
  echo $max >src/migrations/max_migration.txt
}

dirs() {
  du -d 8 \
    -I .git \
    -I .github \
    -I .swm \
    -I .pytest_cache \
    -I .venv \
    -I .vim \
    -I .vscode \
    -I __pycache__ \
    -I bin \
    -I misc \
    -I node_modules \
    ~/.dotfiles \
    ~/.config/nvim \
    ~/.config/tmux \
    ~/.config/zsh \
    ~/.scripts \
    2>/dev/null
}

lines() {
  cat $1 | wc -l
}

explore() {
  rg --color=always --line-number --no-heading --smart-case "" |
    fzf --ansi --delimiter : \
      --preview 'bat --style=full --color=always --highlight-line {2} {1}' \
      --preview-window '~4,+{2}+4/3,<80(up)' \
      --height 100% \
      --layout default
}

se() {
  file=$(du -a \
    ~/.wezterm.lua \
    ~/.config/alacritty \
    ~/.config/nvim \
    ~/.config/tmux \
    ~/.config/zsh \
    ~/.scripts |
    awk '{print $2}' |
    fzf)
  if [ -n "$file" ]; then
    $EDITOR $file
  fi
}

sd() {
  dir=$(dirs | awk '{print $2}' | fzf)
  retVal=$?

  if [ $retVal -eq 0 ]; then
    cd $dir
  fi
}

tsd() {
  dir=$(dirs | awk '{print $2}' | fzf)
  retVal=$?

  if [ $# -gt 0 ]; then
    session=$1
  else
    session="ide"
  fi

  if [ $retVal -eq 0 ]; then
    tmux new-session -c $dir -s $session -n code -d \; \
      attach -t $session
  fi
}

sdls() {
  sd
  if [ $retVal -eq 0 ]; then
    ls
  fi
}

stat() {
  dir=$(du -d2 $(cat ~/.curQ) | grep -e 'STAT.*pset' | awk '{print $2}' | fzf --select-1)
  retVal=$?

  if [ $retVal -eq 0 ]; then
    tmux new-session -c $dir -s stat -n pset -d \; \
      attach -t stat
  fi
}

ide() {
  backend_path=~/dev/codes-health/backend/
  frontend_path=~/dev/codes-health/frontend/

  if [ $# -gt 0 ]; then
    session=$1
  else
    session="ide"
  fi

  tmux new-session -c "$backend_path" -s "$session" -n "svr" -d \; \
    split-window -c "$frontend_path" -h \; \
    select-pane -t "$session":svr.0

  tmux attach -t "$session"
}

tat() {
  session=$(tmux ls | cut -d: -f1 | fzf --select-1 --exit-0)
  retVal=$?
  if [ $retVal -eq 0 ]; then
    tmux attach -t $session
  fi
}

tkill() {
  session=$(tmux ls | cut -d: -f1 | fzf --exit-0)
  retVal=$?
  if [ $retVal -eq 0 ]; then
    tmux kill-session -t $session
  fi
}

scrollback() {
  local tmp=$(mktemp)
  tmux capture-pane -pS -${1:-10000} >"$tmp"
  $EDITOR +"?\\S" +nohl "$tmp"
  rm -f "$tmp"
}

heavyapps() {
  ps aux |
    awk 'NR==1 || $3+0 > 0.5 || $4+0 > 0.5' |
    sort -k3 -rn |
    head -40 |
    awk 'BEGIN {printf "%-10s %-7s %-6s %-6s %s\n", "USER", "PID", "%CPU", "%MEM", "COMMAND"} NR>1 {printf "%-10s %-7s %-6s %-6s %s\n", $1, $2, $3, $4, $11}' |
    column -t
}

randp() {
  if [ -n "$1" ]; then
    dir=$1
  fi
  du -a $1 |
    grep -i -E '\.(png|jpg|jpeg|gif)$' |
    shuf -n 1000 |
    sed 's/\ |\(|\)/\\\ /g' |                               # Put a "\" before spaces
    awk '{for (i=2; i<NF; i++) printf $i " "; print $NF}' | # Remove leading numbers
    sxiv -i -t
}

pkgsizes() {
  pacman -Qei |
    gawk '/^Name/ { x = $3 }; /^Installed Size/ { sub(/Installed Size  *:/, ""); print x":" $0 }' |
    grep MiB |
    sort -k2,3nr |
    less
}

pset() {
  name="pset${1}.tex"
  cp ~/.config/zsh/templates/pset.tex $name
}

tname() {
  name=$(basename "$(pwd)")
  tmux rename-window "$name"
}

